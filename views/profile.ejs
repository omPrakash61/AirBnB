<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-expand-lg bg-body-tertiary fixed-top shadow-sm">
      <div class="container-fluid m-1">
        <a class="navbar-brand" href="/">
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Airbnb_Logo_B%C3%A9lo.svg/1200px-Airbnb_Logo_B%C3%A9lo.svg.png"
            alt="Airbnb Logo"
            height="40"
          />
        </a>
        <button
          class="navbar-toggler dark-toggle"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link card-text" href="/listing">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link card-text" href="/listing/new">Add More</a>
            </li>
          </ul>

          <div class="d-flex align-items-center ms-3">
            <button id="theme-toggle" class="btn btn-dark me-3">🌙</button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Profile Card -->
    <div class="container mt-5 pt-5">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
          <div class="card border-0 rounded-4 shadow-lg p-4">
            <div class="card-body text-center">
              <img
                src="https://cdn-icons-png.flaticon.com/512/6522/6522516.png"
                alt="User Avatar"
                class="rounded-4 mb-3 bg-light p-2"
                width="100"
              />
              <h2 class="card-title fw-bold"><%= profileUser.name %></h2>

              <ul class="list-group list-group-flush">
                <li class="text-body bg-secondary-subtle p-2 m-2 rounded">
                  <strong>📧 Email:</strong> <%= profileUser.email %>
                </li>
                <li class="text-body bg-secondary-subtle p-2 m-2 rounded">
                  <strong>🌍 Country:</strong> <%= profileUser.country %>
                </li>
                <li class="text-body bg-secondary-subtle p-2 m-2 rounded">
                  <strong>⚧ Gender:</strong> <%= profileUser.gender %>
                </li>
                <li class="text-body bg-secondary-subtle p-2 m-2 rounded">
                  <strong>📞 Contact:</strong> <%= profileUser.contact %>
                </li>
              </ul>

              <div class="d-flex justify-content-center gap-5 mt-3">
                <form action="/logout" method="post">
                  <button class="btn btn-danger">Log Out</button>
                </form>
                <a href="/edit-profile" class="btn btn-primary">Edit Profile</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JavaScript for Dark Mode Toggle -->
    <script src="/logic.js"></script>
  </body>
</html>
