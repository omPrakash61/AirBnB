<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirBnB</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class=" dark bg-gray-900 flex justify-center items-center min-h-screen">

    <div
      class=" dark:bg-gray-800 p-8 rounded-lg shadow-md max-w-lg text-center z-10"
    >
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
        Welcome to AirBnB
      </h2>
      <h3 class="text-lg text-gray-700 dark:text-gray-300 mt-2">
        Explore our listings, book your next favorite place, and enjoy a
        wonderful journey!
      </h3>

      <div class="mt-6 flex flex-col space-y-4">
        <form action="/login" method="get">
          <button
            class="w-full py-2 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 transition duration-300"
          >
            Login
          </button>
        </form>

        <form action="/signUp" method="get">
          <button
            class="w-full py-2 bg-green-600 text-white font-semibold rounded-lg shadow-md hover:bg-green-700 transition duration-300"
          >
            Sign Up
          </button>
        </form>

        <p class="text-gray-600 dark:text-gray-300 text-center mt-4">
          Explore as Guest?
          <a href="/listing" class="text-blue-500 ">Let's Go</a>
      </p>
      </div>
    </div>
  </body>
</html>
