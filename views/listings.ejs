<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Listings</title>

    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/style.css" />
  </head>

  <body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-body-tertiary fixed-top shadow-sm">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Airbnb_Logo_B%C3%A9lo.svg/1200px-Airbnb_Logo_B%C3%A9lo.svg.png" alt="Airbnb Logo" height="40" />
        </a>
    
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
          aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
    
        <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
          
          <form class="d-flex mx-3" role="search" action="/search" method="GET" style="max-width: 400px; width: 100%;">
            <input class="form-control me-3" type="search" name="query" placeholder="Search listings..." aria-label="Search" required>
            <button class="btn btn-outline-success" type="submit">Search</button>
          </form>
    
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/listing">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/listing/new">Add More</a>
            </li>
          </ul>
    
          <div class="d-flex align-items-center ms-3">
            <button id="theme-toggle" class="btn btn-dark me-3" title="Toggle Theme">🌙</button>
    
            <% if (!loggedInUser) { %>
            <form action="/login" method="get">
              <button class="btn btn-danger d-flex align-items-center px-3 py-2 rounded-3 shadow-sm">
                Log In
                <img src="https://cdn-icons-png.flaticon.com/512/6522/6522516.png" alt="User Icon" class="ms-2" width="20" />
              </button>
            </form>
            <% } else { %>
            <div class="dropdown">
              <button
                class="btn btn-success d-flex align-items-center px-3 py-2 rounded-3 dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                <span class="text-white"><%= loggedInUser.name %></span>
                <img
                  src="https://cdn-icons-png.flaticon.com/512/6522/6522516.png"
                  alt="User Icon"
                  class="ms-2"
                  width="25"
                />
              </button>
    
              <ul
                class="dropdown-menu dropdown-menu-end"
                aria-labelledby="profileDropdown"
              >
                <li>
                  <form action="/profile/<%= loggedInUser._id %>" method="get">
                    <button class="dropdown-item d-flex align-items-center">
                      Profile
                    </button>
                  </form>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                  <form action="/logout" method="post">
                    <button
                      class="dropdown-item d-flex align-items-center text-danger"
                    >
                      Log Out
                    </button>
                  </form>
                </li>
              </ul>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </nav>
    
    <div class="container mt-5 pt-5">
      <div class="row">
        <% for (let i = 0; i < listings.length; i++) { 
             let element = listings[i]; 
             let carouselId = `carouselExample${i}`; // Generate a unique ID for each carousel
        %>
        <div class="col-md-6 col-lg-4 mb-4">
          <a href="/listing/<%= element._id %>" class="text-decoration-none">
            <div class="card border-0 rounded-4">
              <!-- Unique ID for each carousel -->
              <div id="<%= carouselId %>" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner rounded-4">
                  <div class="carousel-item active" data-bs-interval="10000">
                    <img src="<%= element.image.url %>" class="d-block w-100" style="height: 240px; object-fit: cover" alt="AirBnB Img">
                  </div>
                  <div class="carousel-item" data-bs-interval="2000">
                    <img src="<%= element.image.url %>" class="d-block w-100" style="height: 240px; object-fit: cover" alt="AirBnB Img">
                  </div>
                  <div class="carousel-item">
                    <img src="<%= element.image.url %>" class="d-block w-100" style="height: 240px; object-fit: cover" alt="AirBnB Img">
                  </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#<%= carouselId %>" data-bs-slide="prev">
                  <span class="carousel-control-prev-icon Cicon"></span>
                  <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#<%= carouselId %>" data-bs-slide="next">
                  <span class="carousel-control-next-icon Cicon"></span>
                  <span class="visually-hidden">Next</span>
                </button>
              </div>
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                  <h5 class="card-title text-truncate"><%= element.title %></h5>
                  <span class="badge bg-warning text-dark">⭐ 4.5</span>
                </div>
    
                <p class="card-text" style="max-height: 50px;">
                  <%= element.description %>
                </p>
    
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <div>
                    <h6 class="fw-bold text-primary p-2">₹<%= element.price %></h6>
                    <h6 class="text-muted card-text"><%= element.location %>, <%= element.country %></h6>
                  </div>
                  <button class="btn btn-primary btn-sm">BnB it</button>
                </div>
              </div>
            </div>
          </a>
        </div>
        <% } %>
      </div>
    </div>
    

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JavaScript for Dark Mode Toggle -->
    <script src="/logic.js"></script>
  </body>
</html>
