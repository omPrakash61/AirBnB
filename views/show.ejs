<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Listing Details</title>

    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Bootstrap Icons -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/style.css" />
    <style>
      .cover {
        width: 100%;
        max-height: 500px;
        object-fit: cover;
      }

      .booking-card {
        top: 6rem;
      }

      /* Adjustments for smaller screens */
      @media (max-width: 992px) {
        .cover {
          max-height: 300px;
        }

        .booking-card {
          margin-top: 2rem;
          position: static !important;
        }
      }

      body.dark-mode .textSuffered {
        color: #ffffff;
      }
      body.dark-mode.dark-toggle.navbar-toggler-icon {
        color: white;
      }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary fixed-top shadow-sm">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Airbnb_Logo_B%C3%A9lo.svg/1200px-Airbnb_Logo_B%C3%A9lo.svg.png"
            alt="Airbnb Logo"
            height="40"
          />
        </a>
        <button
          class="navbar-toggler dark-toggle"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/listing">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/listing/new">Add More</a>
            </li>
          </ul>

          <div class="d-flex align-items-center ms-3">
            <button
              id="theme-toggle"
              class="btn btn-dark me-3"
              title="Toggle Theme"
            >
              🌙
            </button>

            <div class="dropdown">
              <button
                class="btn btn-success d-flex align-items-center px-3 py-2 rounded-3 dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                <span class="text-white"><%= loggedInUser.name %></span>
                <img
                  src="https://cdn-icons-png.flaticon.com/512/6522/6522516.png"
                  alt="User Icon"
                  class="ms-2"
                  width="25"
                />
              </button>

              <ul
                class="dropdown-menu dropdown-menu-end"
                aria-labelledby="profileDropdown"
              >
                <li>
                  <form action="/profile/<%= loggedInUser._id %>" method="get">
                    <button class="dropdown-item d-flex align-items-center">
                      Profile
                    </button>
                  </form>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                  <form action="/logout" method="post">
                    <button
                      class="dropdown-item d-flex align-items-center text-danger"
                    >
                      Log Out
                    </button>
                  </form>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="container mt-5 pt-5 mb-5">
      <div class="row">
        <div class="col-lg-8">
          <h1><%= item.title %></h1>

          <img
            src="<%= item.image.url %>"
            alt="Listing Image"
            class="cover rounded-4 mb-4 shadow-lg"
          />

          <p class="textSuffered" style="line-height: 1.7">
            <%= item.description %> Lorem ipsum dolor sit amet consectetur
            adipisicing elit. Dolorum incidunt itaque in harum cum fugiat
            veritatis? Nisi laudantium dolorum modi.
          </p>

          <hr class="my-5" />

          <div
            class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 py-3 px-3"
          >
            <!-- Host Info -->
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-person-lines-fill fs-3 text-primary"></i>
              <h5 class="mb-0">Hosted by <%= item.host %></h5>
            </div>

            <!-- Rating -->
            <div class="text-end">
              <h6 class="mb-1">Rating</h6>
              <div class="text-warning fs-5">
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-half"></i>
                <i class="bi bi-star"></i>
              </div>
            </div>
          </div>

          <hr class="my-5" />

          <section>
            <h2 class="fw-semibold mb-3">Amenities</h2>
            <ul
              class="list-unstyled row row-cols-md-2 row-cols-lg-3 g-2 fs-6"
              style="line-height: 45px"
            >
              <li><i class="bi bi-wifi pe-2 text-primary"></i>Free Wi-Fi</li>
              <li><i class="bi bi-tv pe-2 text-danger"></i>Television</li>
              <li>
                <i class="bi bi-cup-hot pe-2 text-warning"></i>Kitchenette
              </li>
              <li>
                <i class="bi bi-thermometer-half pe-2 text-info"></i>Air
                Conditioning
              </li>
              <li>
                <i class="bi bi-droplet-fill pe-2 text-primary"></i>Hot Water
              </li>
              <li>
                <i class="bi bi-car-front-fill pe-2 text-success"></i>Free
                Parking
              </li>
            </ul>
          </section>

          <hr class="my-5" />

          <section>
            <h2 class="fw-semibold mb-3">Location</h2>
            <p class="textSuffered">
              This amazing place is located in <%= item.location %>, <%=
              item.country %>. Enjoy the local culture and nearby attractions.
            </p>

            <!-- Map Placeholder -->

            <div id="location" class="map-responsive rounded-3 shadow-md">
              <iframe
                src="https://maps.google.com/maps?q=<%= item.latitude %>,<%= item.longitude %>&z=15&output=embed"
                frameborder="0"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </section>
        </div>

        <div class="col-lg-4">
          <div
            class="card shadow-lg border-0 rounded-4 p-4 bg-white booking-card sticky-top"
          >
            <div class="card-body">
              <form
                action="/listing/booking/<%=item._id%>"
                method="post"
                novalidate
                class="needs-validation"
              >
                <div
                  class="d-flex justify-content-between align-items-center mb-3"
                >
                  <h4 class="text-success fw-bold mb-0">
                    ₹<%= item.price %>/-
                  </h4>
                  <input
                    type="number"
                    name="price"
                    value="<%= item.price %>"
                    hidden
                  />
                  <small>per night (before taxes)</small>
                </div>

                <hr class="my-3" />

                <h5 class="fw-semibold mb-3">Book Your Stay</h5>
                <p class="textSuffered">
                  Experience <%= item.location %>, <%= item.country %>. Cozy
                  stay, vibrant culture, and top hospitality await.
                </p>
                <input
                  type="text"
                  name="country"
                  value="<%= item.country %>"
                  hidden
                />
                <input
                  type="text"
                  name="location"
                  value="<%= item.location %>"
                  hidden
                />

                <div class="mb-3">
                  <label for="checkin" class="form-label small">Check-in</label>
                  <input
                    type="date"
                    class="form-control rounded-3"
                    name="checkin"
                    min="<%= new Date().toISOString().split('T')[0] %>"
                    required
                  />
                </div>
                <div class="mb-3">
                  <label for="checkout" class="form-label small"
                    >Check-out</label
                  >
                  <input
                    type="date"
                    class="form-control rounded-3"
                    name="checkout"
                    required
                  />
                </div>
                <div class="mb-3">
                  <label for="guests" class="form-label small">Guests</label>
                  <select
                    class="form-select rounded-pill"
                    id="guests"
                    name="guest"
                  >
                    <option value="1">1 Guest</option>
                    <option value="2">2 Guests</option>
                    <option value="3">3 Guests</option>
                    <option value="4">4 Guests</option>
                  </select>
                </div>

                <div class="d-grid gap-2 mt-4">
                  <button class="btn btn-primary btn-lg rounded-3 shadow-sm">
                    Book Now
                  </button>

                  <%if(loggedInUser.name == item.host){%>
                  <a
                    href="/deleteListing/<%=item._id%>"
                    class="btn textSuffered btn-danger rounded-3"
                  >
                    Delete Listing
                  </a>                  
                  <%}else{%>

                  <button
                    class="btn textSuffered btn-outline-secondary rounded-3"
                  >
                    Contact Host
                  </button>

                  <%}%>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Bootstrap & Script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="/logic.js"></script>
  </body>
</html>
