<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Place</title>

    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>

  <body class="bg-light pt-5">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg fixed-top bg-white shadow-sm">
      <div class="container-fluid px-4 py-2">
        <a class="navbar-brand" href="/">
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Airbnb_Logo_B%C3%A9lo.svg/1200px-Airbnb_Logo_B%C3%A9lo.svg.png"
            alt="Logo"
            height="35"
          />
        </a>
        <button
          class="navbar-toggler dark-toggle"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div
          class="collapse navbar-collapse justify-content-end"
          id="navbarNav"
        >
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/listing">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/listing/new">Add More</a>
            </li>
          </ul>
          <button
            id="theme-toggle"
            class="btn btn-dark ms-3 px-3 py-2"
            title="Toggle Theme"
          >
            🌙
          </button>
        </div>
      </div>
    </nav>

    <!-- Form Container -->
    <main
      class="container d-flex justify-content-center align-items-start pt-5 mt-3 mb-5"
    >
      <div
        class="card border-0 shadow-lg rounded-4 p-4 w-100"
        style="max-width: 600px"
      >
        <h2 class="text-center text-primary mb-4">Enter Place Details</h2>

        <form
          action="/create"
          method="post"
          class="row needs-validation"
          novalidate
        >
          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input
              type="text"
              id="title"
              name="title"
              class="form-control"
              placeholder="Enter a title"
              required
            />
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea
              id="description"
              name="description"
              class="form-control"
              rows="4"
              placeholder="Write a brief description..."
              required
            ></textarea>
          </div>

          <!-- Image URL -->
          <div class="mb-3">
            <label for="url" class="form-label">Image URL</label>
            <input
              type="url"
              id="url"
              name="url"
              class="form-control"
              placeholder="https://example.com/image.jpg"
              required
            />
          </div>

          <!-- Location and Country -->
          <div class="mb-3 col-md-5">
            <label for="location" class="form-label">Location</label>
            <input
              type="text"
              id="location"
              name="location"
              class="form-control"
              placeholder="City"
              required
            />
          </div>

          <div class="mb-3 col-md-7">
            <label for="country" class="form-label">Country</label>
            <input
              type="text"
              id="country"
              name="country"
              class="form-control"
              placeholder="Country"
              required
            />
          </div>

          <!-- Latitide and Longitude -->
          <div class="mb-3 col-md-7">
            <label for="latitude" class="form-label">Latitide <span> (provide As Per the Google Map.)</span></label>
            <input
              type="text"
              id="location"
              name="latitude"
              class="form-control"
              placeholder="Latitude"
              required
            />
          </div>

          <div class="mb-3 col-md-5">
            <label for="longitude" class="form-label">Longitude</label>
            <input
              type="text"
              id="country"
              name="longitude"
              class="form-control"
              placeholder="Longitude"
              required
            />
          </div>

          <!-- Price -->
          <div class="mb-4">
            <label for="price" class="form-label">Price</label>
            <input
              type="number"
              id="price"
              name="price"
              class="form-control"
              placeholder="Enter price"
              required
            />
          </div>

          <!-- Buttons -->
          <div class="d-flex justify-content-between">
            <a href="/listing" class="btn btn-danger">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">Save</button>
          </div>
        </form>
      </div>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Dark Mode Toggle Script -->
    <script src="/logic.js"></script>

    <!-- Form validation -->
    <script>
      (() => {
        "use strict";
        const forms = document.querySelectorAll(".needs-validation");
        Array.from(forms).forEach((form) => {
          form.addEventListener(
            "submit",
            (event) => {
              if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
              }
              form.classList.add("was-validated");
            },
            false
          );
        });
      })();
    </script>
  </body>
</html>
